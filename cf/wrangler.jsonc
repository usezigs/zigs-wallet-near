{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zec-frost",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  // No request logs: the server must not keep IP addresses or timing.
  "observability": { "enabled": false },
  "preview_urls": false,
  "build": {
    "command": "npm ci --prefix ../web --no-audit --no-fund && npm run build --prefix ../web",
    "watch_dir": "../web/openglass"
  },
  // The Solana beta: "1" serves web/sol (ZOLANA.md). The Helius Devnet URL is the secret
  // HELIUS_DEVNET_URL: set it with `wrangler secret put`, never here.
  // The plain wallet on mainnet: SOL_MAINNET "1" serves /sol/config-mainnet.json and, with SOL
  // off, the files of web/sol/plain. The Helius mainnet URL is the secret HELIUS_MAINNET_URL, set
  // the same way. SOL_MAINNET is "1" on staging only. Production stays "0" until the owner
  // turns it on.
  // The private mainnet wallet: SOL_POOL_MAINNET "1" serves /sol/worker-mainnet.js (needs SOL "1").
  // It is "0" everywhere until the owner turns it on for staging.
  // DEV_NO_AUTH "1": app.zigs.app asks no password (src/gate.js). Staging keeps its password.
  // NEAR_LIVE "1" serves the live swaps between SOL and ZEC (/near/swap, /near/swap-sol-group,
  // /near/swap-zec and /near/status in src/near.js).
  // It is "1" on staging only. The partner key of NEAR Intents is the secret NEAR_API_KEY, set
  // with `wrangler secret put`. Basic confidential execution requires it. Explicit Standard
  // execution and public sample-address price estimates can work without the key.
  // Portfolio market data: set COINGECKO_DEMO_API_KEY or COINGECKO_PRO_API_KEY as a secret.
  // No wallet addresses or balances are sent to the price provider. See docs/portfolio-tracker.md.
  "vars": {
    "SOL": "1", "SOL_MAINNET": "0", "SOL_POOL_MAINNET": "0", "DEV_NO_AUTH": "1", "NEAR_LIVE": "0"
  },
  "routes": [{ "pattern": "app.zigs.app", "custom_domain": true }],
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // New group connections per network and minute, counted per Cloudflare location
  // (approximate). A network is an IPv4 address or the /64 of an IPv6 address (clientKey in
  // src/index.js).
  // Light-wallet relay calls (/lwd) per network and minute, the same way. A first sync of a
  // month of blocks peaks at 68 calls a minute (TICKETS.md PRIV-8).
  // Swap quotes and swap states (/near/quote, /near/swap, /near/status) per network and minute,
  // the same way: the three routes share one counter.
  "ratelimits": [
    { "name": "WS_PER_IP", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "LWD_PER_IP", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
    { "name": "NEAR_PER_IP", "namespace_id": "1007", "simple": { "limit": 60, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // The staging copy (VEL-2): its own Worker, Durable Object data, password and rate counter, at
  // staging.zigs.app. scripts/deploy-staging.sh deploys main to it. vars, ratelimits and
  // durable_objects are not inherited, so they are set here. name and routes are inherited, so
  // they are set here too: staging must never take the production name or domain. migrations
  // are inherited, so a new migration applies to both.
  "env": {
    "staging": {
      "name": "zec-frost-staging",
      "vars": {
        "SOL": "1", "SOL_MAINNET": "1", "SOL_POOL_MAINNET": "1", "DEV_NO_AUTH": "0",
        "NEAR_LIVE": "1"
      },
      "routes": [{ "pattern": "staging.zigs.app", "custom_domain": true }],
      "ratelimits": [
        { "name": "WS_PER_IP", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
        { "name": "LWD_PER_IP", "namespace_id": "1006", "simple": { "limit": 600, "period": 60 } },
        { "name": "NEAR_PER_IP", "namespace_id": "1008", "simple": { "limit": 60, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [{ "name": "STORE", "class_name": "Store" }]
      }
    }
  }
}
