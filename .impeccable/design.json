  "narrative": {
    "northStar": "Discreet, precise, a little wild",
    "overview": "Zigs pairs the original zebra fingerprint and artwork with a quiet working interface. The approved\ncharacter comes from the product itself: recognizable identity, exact financial records, restrained\ncontrols and a clear distinction between navigation, a document and a temporary surface.\n\nThis documents the implemented system, rather than proposing a replacement. The source of truth\nfor runtime values remains `web/design-system.css`, followed by the component and refinement\nstyles loaded by `web/index.html`. Both themes are first-class. The isolated Stageshow illustrations\nare examples of the product, not a source of miniature geometry for the live application.",
    "keyCharacteristics": [
      "Original zebra identity and wallet identity artwork.",
      "Warm chalk or charcoal, with icy blue used for focus and selected detail.",
      "Precise, restrained typography and complete financial identifiers.",
      "Subtle elevation, with glass reserved for orientation and utility chrome."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Every surface takes its foreground and controls from the same theme.",
        "section": "colors"
      },
      {
        "name": "The State Evidence Rule",
        "body": "Color reinforces an established state; it never establishes success itself.",
        "section": "colors"
      },
      {
        "name": "The Complete Value Rule",
        "body": "Preserve exact native amounts, units, full addresses and full comparison\nvalues. Wrap or disclose long records deliberately; do not silently replace a decision-relevant value\nwith an illustration placeholder or truncation.",
        "section": "typography"
      },
      {
        "name": "The Working Document Rule",
        "body": "Let financial information read as a coherent document, with one\nprimary task and exact values; do not turn every supporting fact into an equally prominent card.",
        "section": "layout"
      },
      {
        "name": "The Utility Glass Rule",
        "body": "Use glass to maintain location around a task, while the task's financial\ncontent keeps a stable, readable surface.",
        "section": "elevation"
      },
      {
        "name": "The Scope Rule",
        "body": "Name the browser, device and chain covered by a recovery state or action. Local file checks and reports from other devices remain separate kinds of evidence.",
        "section": "components"
      },
      {
        "name": "The Navigation Group Rule",
        "body": "Group money, contacts and wallet-care tasks while keeping their destinations directly available.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the original zebra identity and the approved restrained material character.",
      "Do use matching semantic surface, text and control tokens in each theme.",
      "Do keep the complete financial record and the actual next action understandable together.",
      "Do compose mobile for touch, scrolling, visible focus and enlarged text.",
      "Do keep reduced-motion, reduced-transparency and forced-color fallbacks working."
    ],
    "donts": [
      "Don't introduce a new visual world during a refinement pass.",
      "Don't use decorative success styling to imply a payment or recovery step completed.",
      "Don't put transparent glass behind decision-relevant financial values.",
      "Don't scale miniature illustration controls into the live app.",
      "Don't replace real marks with invented monograms or omit capability disclosures."
    ]
  }
}
